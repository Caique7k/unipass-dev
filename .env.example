# Variáveis do container do PostgreSQL do docker-compose.yml (serviço
# postgres). Copie para .env, na raiz do projeto.
#
# - As três só valem na primeira subida do banco (volume vazio). Depois disso,
#   mudar aqui não muda o usuário, a senha nem o banco que já existem.
# - O backend não lê este arquivo: as variáveis dele ficam em backend/.env
#   (veja backend/.env.example).

# POSTGRES_USER (obrigatória): usuário criado na primeira subida. Tem de ser o
# mesmo usuário da DATABASE_URL dos serviços backend e backend-worker no
# docker-compose.yml.
POSTGRES_USER=unipass

# POSTGRES_PASSWORD (obrigatória, segredo): senha desse usuário. Com o
# docker-compose.yml de hoje, tem de ser a mesma senha escrita na DATABASE_URL
# dos serviços backend e backend-worker; se mudar uma, mude a outra.
# Num ambiente novo, gere com: openssl rand -hex 24 (hex porque a senha também
# entra numa URL).
POSTGRES_PASSWORD=

# POSTGRES_DB (obrigatória): banco criado na primeira subida. Tem de ser o
# mesmo banco da DATABASE_URL dos serviços backend e backend-worker no
# docker-compose.yml.
POSTGRES_DB=unipass_db
